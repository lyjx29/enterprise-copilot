# ============================================================
# FinCopilot 环境变量清单（复制为 .env 后按需修改）
# 敏感项只进 .env，绝不提交
# ============================================================

# ---- LLM（生成/推理）----
LLM_PROVIDER=ollama          # "ollama" | "openai" | "anthropic"
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3

# ---- Embedding（bi-encoder，召回）----
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_NUM_CTX=8192

# ---- Reranker（cross-encoder，精排）—— 本地优先，可切云端 ----
RERANK_PROVIDER=ollama       # "ollama" | "openai" | "cohere" | "jina"
RERANK_MODEL=bge-reranker

# ---- 分块（离线索引）----
CHUNK_STRATEGY=semantic_page # semantic_page | plain_page | llm_page
CHUNK_SEMANTIC_THRESHOLD=0.2

# ---- 向量库（Qdrant 独立服务）----
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=financial_docs
QDRANT_HNSW_M=16
QDRANT_HNSW_EF_CONSTRUCT=100

# ---- 数据 ----
EMPLOYEES_DB_URI=sqlite:///data/employees.db   # 只读打开
CHECKPOINT_DB_PATH=data/checkpoints.db

# ---- 检索（双路召回 → 融合 → 精排）----
ENABLE_HYDE=false
ENABLE_PRF=false
FUSION_METHOD=rrf            # rrf | simple_merge
RECALL_TOP_N1=20
RECALL_TOP_N2=20
FUSE_TOP_N=15
RERANK_TOP_K=5
GRADE_THRESHOLD=0.6

# ---- SQL 安全（纵深防御）----
# pydantic-settings 列表用 JSON 数组格式
SQL_ALLOWED_TABLES=["employees","departments","dept_emp","salaries","titles"]
SQL_QUERY_TIMEOUT_S=3.0
SQL_MAX_ROWS=100

# ---- 安全 ----
# 生产必须配置；留空 = 本地开发关闭鉴权。多 key 用 JSON 数组：API_KEYS=["k1","k2"]
API_KEYS=
RATE_LIMIT_PER_MINUTE=60

# ---- 观测（Langfuse 可选）----
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# ---- 运行时 ----
MAX_ITERATIONS=3
LOG_LEVEL=INFO
